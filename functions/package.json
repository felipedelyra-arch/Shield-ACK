{
  "name": "shieldack-functions",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint src --ext .ts",
    "test": "firebase emulators:exec --project=demo-shieldack \"vitest run\"",
    "test:rules": "firebase emulators:exec --only firestore,database --project=demo-shieldack \"vitest run ../test/rules\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,database",
    "audit": "npm audit --audit-level=high",
    "deploy": "npm run build && firebase deploy --only functions",
    "test:local": "vitest run",
    "seed": "npm run build && FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} node scripts/seed-emulator.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
