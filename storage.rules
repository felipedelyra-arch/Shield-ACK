rules_version = '2';

// Storage guarda APENAS asset estático: avatar e thumbnail.
// Vídeo nunca entra aqui — vai para CDN dedicada com token assinado.
service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /thumbnails/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false; // publicado por Function administrativa
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
