<?xml version="1.0" encoding="utf-8"?>
<!--
  Só no build de DEBUG (substitui o arquivo de src/main). Igual ao de release,
  mais HTTP em claro para o Firebase Emulator Suite em máquina local.
  Release continua com cleartextTrafficPermitted=false sem exceção.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
